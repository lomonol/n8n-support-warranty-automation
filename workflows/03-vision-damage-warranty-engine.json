    {
      "id": "e88f08f2-97f6-4ed0-ac60-f1f920985cd2",
      "name": "Multi-Modal Vision Inspection",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        112
      ],
      "parameters": {
        "promptType": "define",
        "text": "=CUSTOMER DAMAGE REPORT:\nCustomer Email: {{ $('Parse Claim & Normalize Attachments').item.json.customer_email }}\nReferenced Order: {{ $('Parse Claim & Normalize Attachments').item.json.order_number }}\nPurchased Items: {{ JSON.stringify($('Parse Claim & Normalize Attachments').item.json.items) }}\nOrder Value: ${{ $('Parse Claim & Normalize Attachments').item.json.order_value }}\nCustomer Complaint:\n\"{{ $('Parse Claim & Normalize Attachments').item.json.raw_message }}\"\n\nThe photo evidence is attached as an image. Please inspect it and evaluate it against the customer complaint.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are the Senior Fulfillment & Warranty Inspection AI for Lumina Goods Co.\nYour job is to examine photographic evidence of damaged products delivered to customers.\n\nEvaluation Rubric:\n1. Authenticity: Does the image show actual physical damage (cracks, shattered ceramics, torn fabrics, leaking liquids, punctures, structural defects)?\n2. Severity:\n   - \"catastrophic\" - Completely broken, unusable, shattered ceramic/glass, heavy structural destruction.\n   - \"moderate\" - Significant visible crack, dent, or functional defect.\n   - \"minor\" - Superficial cosmetic scratch or dent that does not prevent normal use.\n   - \"no_damage\" - Product appears intact, pristine, or photo is unrelated/blurry.\n3. Confidence Score: 0 to 100 rating your visual certainty.\n4. Reasoning: Precise visual details explaining the damage found in the image.\n\nCRITICAL OUTPUT REQUIREMENT:\nYou MUST format your entire response as a JSON markdown codeblock wrapped under the root key \"output\", exactly matching:\n```json\n{\n  \"output\": {\n    \"damage_detected\": true,\n    \"damage_severity\": \"catastrophic\",\n    \"confidence_score\": 95,\n    \"item_description\": \"Detailed description of item and damage\",\n    \"ai_audit_reasoning\": \"Visual proof analysis\"\n  }\n}\n```\nDo not include any text before or after the JSON markdown block.",
              "type": "SystemMessagePromptTemplate"
            },
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "data",
              "imageDetail": "auto"
            }
          ]
        }
      }
    },
    {
      "id": "4bad0885-0587-40e8-8f5e-eae877e36988",
      "name": "OpenRouter Vision Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        464,
        336
      ],
      "parameters": {
        "model": "google/gemini-2.5-flash",
        "options": {
          "temperature": 0.1,
          "maxTokens": 800
        }
      },
      "credentials": {
        "openRouterApi": {
          "id": "REPLACE_ME",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "id": "29f0b99f-51cb-4f51-a044-35cf593f028f",
      "name": "Damage Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        592,
        336
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"damage_detected\": {\n      \"type\": \"boolean\",\n      \"description\": \"True if genuine physical damage or defect is visible in the photo\"\n    },\n    \"damage_severity\": {\n      \"type\": \"string\",\n      \"enum\": [\"minor\", \"moderate\", \"catastrophic\", \"no_damage\"],\n      \"description\": \"Severity level of the observed defect\"\n    },\n    \"confidence_score\": {\n      \"type\": \"number\",\n      \"description\": \"Confidence score between 0 and 100\"\n    },\n    \"item_description\": {\n      \"type\": \"string\",\n      \"description\": \"Brief description of the damaged item identified in the image\"\n    },\n    \"ai_audit_reasoning\": {\n      \"type\": \"string\",\n      \"description\": \"Detailed visual audit justification\"\n    }\n  },\n  \"required\": [\"damage_detected\", \"damage_severity\", \"confidence_score\", \"ai_audit_reasoning\"]\n}"
      }
    },
    {
      "id": "3b6d29a7-074c-49fa-9723-ab3d6324086a",
      "name": "Is Fast-Path Eligible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        800,
        112
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "cond-damage",
              "leftValue": "={{ $json.output.damage_detected }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "cond-conf",
              "leftValue": "={{ $json.output.confidence_score }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "cond-val",
              "leftValue": "={{ $(\"Parse Claim & Normalize Attachments\").item.json.order_value }}",
              "rightValue": 100,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
