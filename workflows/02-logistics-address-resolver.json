              "name": "proposed_shipping_address",
              "type": "object",
              "value": "={{\n  (() => {\n    const orig = $json.shipping_address || {};\n    const correction = ($json.extracted_address_correction || '').trim();\n    \n    // If customer provided an apartment/unit correction (e.g. \"Apt 4B\", \"Unit 12\", \"Suite 200\")\n    if (correction.match(/^(apt|apartment|unit|suite|ste|#)\\s*\\w+/i) || (correction.length > 0 && correction.length <= 10)) {\n      return {\n        street: orig.street || '',\n        apt: correction,\n        city: orig.city || '',\n        state: orig.state || '',\n        zip: orig.zip || '',\n        country: orig.country || 'USA'\n      };\n    }\n    \n    // If customer provided a full address string\n    return {\n      street: correction || orig.street || '',\n      apt: orig.apt || '',\n      city: orig.city || '',\n      state: orig.state || '',\n      zip: orig.zip || '',\n      country: orig.country || 'USA'\n    };\n  })()\n}}"
            },
            {
              "id": "6e9df995-ffab-490d-9af7-a017b59f9b99",
              "name": "requested_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
